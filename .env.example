# Copy to .env and fill in YOUR credentials. .env is gitignored — never commit real keys.

# ---- Run mode ----------------------------------------------------------------
# paper  = simulated execution (default, safe)
# live   = REAL orders via Tradovate. Requires valid TRADOVATE_* creds below.
PB_MODE=paper

# ---- Risk (aggressive-but-survivable growth plan) ----------------------------
PB_ACCOUNT_EQUITY=1000         # starting capital; sizing compounds as it grows
PB_RISK_PCT=0.02               # 2% risk per trade (hard-capped at 5% in code)
PB_MAX_SETUPS_PER_SESSION=2    # max 2 A+ trades per day
PB_USE_MICROS=true             # MES/MNQ — required for a small account
PB_MIN_RR=1.0                  # accept down to 1:1
PB_TP_MAX_R=3.0                # cap targets at 1:3

# ---- Databento (market data) -------------------------------------------------
# https://databento.com  ->  CME Globex dataset GLBX.MDP3
DATABENTO_API_KEY=
DATABENTO_DATASET=GLBX.MDP3

# ---- Tradovate (execution) ---------------------------------------------------
# Start with the DEMO environment. Switch to live ONLY after paper validation.
TRADOVATE_ENV=demo             # demo | live
TRADOVATE_USERNAME=
TRADOVATE_PASSWORD=
TRADOVATE_APP_ID=
TRADOVATE_APP_VERSION=1.0
TRADOVATE_CID=
TRADOVATE_SECRET=
TRADOVATE_DEVICE_ID=
