# Copy to .env and fill in YOUR credentials. .env is gitignored — never commit real keys.

# ---- Run mode ----------------------------------------------------------------
# paper  = simulated execution (default, safe)
# live   = REAL orders via Tradovate. Requires valid TRADOVATE_* creds below.
PB_MODE=paper

# ---- Risk --------------------------------------------------------------------
PB_ACCOUNT_EQUITY=10000        # account size used for position sizing
PB_RISK_PCT=0.005              # 0.5% max risk per trade (hard-capped in code)
PB_MAX_SETUPS_PER_SESSION=1    # A+ throttle

# ---- Databento (market data) -------------------------------------------------
# https://databento.com  ->  CME Globex dataset GLBX.MDP3
DATABENTO_API_KEY=
DATABENTO_DATASET=GLBX.MDP3

# ---- Tradovate (execution) ---------------------------------------------------
# Start with the DEMO environment. Switch to live ONLY after paper validation.
TRADOVATE_ENV=demo             # demo | live
TRADOVATE_USERNAME=
TRADOVATE_PASSWORD=
TRADOVATE_APP_ID=
TRADOVATE_APP_VERSION=1.0
TRADOVATE_CID=
TRADOVATE_SECRET=
TRADOVATE_DEVICE_ID=
